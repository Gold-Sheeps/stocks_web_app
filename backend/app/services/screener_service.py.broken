class ScreenerService:
    """Screener画面のビジネスロジチE"""
    
    def __init__(self):
        self.db = Database()
        self.db.connect()
    
    def calculate_total_score_v2(self, stock_data: dict) -> dict:
        """
        新Total Score計算！ES Ratingを除外、買ぁEイミング総合判断EE
        
        ゲート条件 + 6つの正規化されたサブスコア
        """
        close = float(stock_data.get('close', 0))
        sma20 = float(stock_data.get('sma20') or 0)
        sma50 = float(stock_data.get('sma50') or 0)
        sma200 = float(stock_data.get('sma200') or 0)
        volume = float(stock_data.get('volume', 0))
        volume_50d_avg = float(stock_data.get('volume_50d_avg', volume))
        macd_hist = float(stock_data.get('macd_hist') or 0)
        rsi14 = float(stock_data.get('rsi14') or 50)
        high_52w = float(stock_data.get('high_52w') or close)
        atr14 = float(stock_data.get('atr14') or 0)
        
        # ゲート条件
        gate_g1 = close > sma200 if sma200 > 0 else False
        gate_g2 = sma50 > sma200 if sma200 > 0 and sma50 > 0 else False
        
        # (A) トレンドスコアEE-100EE
        trend_score = 0.0
        if close > sma20 and sma20 > 0: trend_score += 20
        if close > sma50 and sma50 > 0: trend_score += 20
        if close > sma200 and sma200 > 0: trend_score += 20
        if sma20 > sma50 and sma20 > 0 and sma50 > 0: trend_score += 20
        if sma50 > sma200 and sma50 > 0 and sma200 > 0: trend_score += 20
        
        # (B) 出来高スコアEE-100EE
        vol_ratio = volume / volume_50d_avg if volume_50d_avg > 0 else 1.0
        volume_score = 20.0 if vol_ratio < 0.8 else 40.0 if vol_ratio < 1.0 else 60.0 if vol_ratio < 1.3 else 80.0 if vol_ratio < 1.8 else 95.0
        
        # (C) MACDスコアEE-100EE
        macd_score = 70.0 if macd_hist > 0 else 30.0
        
        # (D) RSIスコアEE-100EE
        if 45 <= rsi14 <= 65: rsi_score = 90.0
        elif (35 <= rsi14 < 45) or (65 < rsi14 <= 70): rsi_score = 70.0
        elif 70 < rsi14 <= 80: rsi_score = 40.0
        elif rsi14 > 80 or rsi14 < 20: rsi_score = 20.0
        else: rsi_score = 50.0
        
        # (E) 52週高値距離スコアEE-100EE
        dist = ((high_52w - close) / high_52w) if high_52w > 0 else 1.0
        high52_score = 95.0 if dist <= 0.05 else 80.0 if dist <= 0.10 else 55.0 if dist <= 0.20 else 30.0
        
        # (F) ATRスコアEE-100EE
        atr_pct = (atr14 / close * 100) if close > 0 else 0
        if 2 <= atr_pct <= 6: atr_score = 90.0
        elif atr_pct < 2: atr_score = 40.0
        elif 6 < atr_pct <= 8: atr_score = 70.0
        elif 8 < atr_pct <= 12: atr_score = 40.0
        else: atr_score = 20.0
        
        # 重み付け合EEE0% ↁE100%に正規化EE
        total = (
            trend_score * 0.25 +
            volume_score * 0.15 +
            macd_score * 0.10 +
            rsi_score * 0.10 +
            high52_score * 0.05 +
            atr_score * 0.05
        ) * (100 / 70)
        
        # ゲート適用
        if not gate_g1: total = min(total, 45)
        if not gate_g2: total = min(total, 60)
        
        return {
            'total_score': round(total, 1),
            'subscores': {
                'trend': round(trend_score, 1),
                'volume': round(volume_score, 1),
                'macd': round(macd_score, 1),
                'rsi': round(rsi_score, 1),
                'high52': round(high52_score, 1),
                'atr': round(atr_score, 1)
            },
            'vol_ratio': round(vol_ratio, 2)
        }
    
    def calculate_canslim_score(self, indicator_data: dict) -> float:
        """
        CANSLIMスコアを計算！E0点満点EE
        
        C: 四半期EPS成長 (8点) - v1では未実裁E
        A: 年間EPS成長 (6点) - v1では未実裁E
        N: 新高値 (8点)
        S: 需給 (6点)
        L: リーダー (8点)
        I: 機関投賁E (2点) - v1では未実裁E
        M: 市場方吁E(2点) - v1では未実裁E
        """
        score = 0.0
        
        # N: 新高値EE2週高値距離EE
        dist_52w = indicator_data.get('dist_to_52w_high_pct')
        if dist_52w is not None:
            if dist_52w >= -5:
                score += 8
            elif dist_52w >= -10:
                score += 4
        
        # S: 需給EE来高比率EE
        volume_ratio = indicator_data.get('volume_ratio')
        if volume_ratio is not None:
            if volume_ratio >= 1.5:
                score += 6
            elif volume_ratio >= 1.2:
                score += 3
        
        # L: リーダーEES ScoreEE
        rs_score = indicator_data.get('rs_score')
        if rs_score is not None:
            if rs_score >= 80:
                score += 8
            elif rs_score >= 70:
                score += 4
        
        return score
    
    def calculate_technical_score(self, indicator_data: dict) -> float:
        """
        チEニカルスコアを計算！E0点満点EE
        
        - ピEチE/買ぁEーン (9点)
        - RSI (6点)
        - MACD (6点)
        - 移動平坁E整刁E(6点)
        - ボリンジャーバンチE(3点) - v1では未実裁E
        """
        score = 0.0
        
        # ピEチE/買ぁEーンEE2週高値距離EE
        dist_52w = indicator_data.get('dist_to_52w_high_pct')
        if dist_52w is not None:
            if dist_52w >= -5:
                score += 9
            elif dist_52w >= -10:
                score += 5
        
        # RSI
        rsi14 = indicator_data.get('rsi14')
        if rsi14 is not None:
            if 30 <= rsi14 <= 70:
                score += 6
            elif 25 <= rsi14 <= 75:
                score += 3
        
        # MACD
        macd_hist = indicator_data.get('macd_hist')
        if macd_hist is not None:
            if macd_hist > 0:
                score += 6
        
        # 移動平坁E整列(パーフェクトオーダーEE
        ema21 = indicator_data.get('ema21')
        sma50 = indicator_data.get('sma50')
        sma200 = indicator_data.get('sma200')
        
        if all([ema21, sma50, sma200]):
            if ema21 > sma50 > sma200:
                score += 6
            elif ema21 > sma50:
                score += 3
        
        return score
    
    def calculate_supply_demand_score(self, indicator_data: dict) -> float:
        """
        需給スコアを計算！E0点満点EE
        
        - 出来高比率 (12点)
        - 累穁E刁EEライン (4点) - v1では未実裁E
        - VSAラベル (4点) - v1では未実裁E
        """
        score = 0.0
        
        # 出来高比率
        volume_ratio = indicator_data.get('volume_ratio')
        if volume_ratio is not None:
            if volume_ratio >= 1.5:
                score += 12
            elif volume_ratio >= 1.2:
                score += 6
        
        return score
    
    def calculate_valuation_score(self, indicator_data: dict) -> float:
        """
        バリュエーションスコアを計算！E0点満点EE
        v1では未実裁E表示のみEE
        """
        return 0.0
    
    def scan_stocks(self, mode: str = 'all', sector: Optional[str] = None, limit: int = 20, offset: int = 0) -> dict:
        """
        銘柄をスキャンしてスコアリング
        
        Args:
            mode: 'all', 'sector', 'theme'
            sector: セクター名！Eode='sector'の場合！E
            limit: 返す銘柄数
            offset: オフセチEEEージネEション用EE
        
        Returns:
            スキャン結果のdict
        """
        # 最適化されたクエリ: 1回Eクエリで全チEEタ取得(E来高平坁E前日比も含むEE
        query = """
            WITH latest_prices AS (
                SELECT 
                    symbol_key,
                    MAX(trading_date) as latest_date
                FROM price_daily
                GROUP BY symbol_key
            ),
            latest_rs AS (
                SELECT DISTINCT ON (symbol_key)
                    symbol_key,
                    rs_score
                FROM indicator_daily
                WHERE rs_score IS NOT NULL
                ORDER BY symbol_key, trading_date DESC
            ),
            volume_avg AS (
                SELECT 
                    symbol_key,
                    AVG(volume) as volume_50d_avg
                FROM (
                    SELECT 
                        symbol_key,
                        volume,
                        ROW_NUMBER() OVER (PARTITION BY symbol_key ORDER BY trading_date DESC) as rn
                    FROM price_daily
                ) ranked
                WHERE rn <= 50
                GROUP BY symbol_key
            ),
            prev_close AS (
                SELECT 
                    symbol_key,
                    close as prev_close
                FROM (
                    SELECT 
                        symbol_key,
                        close,
                        trading_date,
                        ROW_NUMBER() OVER (PARTITION BY symbol_key ORDER BY trading_date DESC) as rn
                    FROM price_daily
                ) ranked
                WHERE rn = 2
            )
            SELECT 
                i.symbol_key,
                i.name,
                p.close,
                p.volume,
                ind.sma20,
                ind.sma50,
                ind.sma200,
                ind.ema21,
                ind.ema50,
                ind.rsi14,
                ind.macd,
                ind.macd_signal,
                ind.macd_hist,
                ind.high_52w,
                ind.low_52w,
                ind.dist_to_52w_high_pct,
                COALESCE(lr.rs_score, 0) as rs_score,
                ind.atr14,
                p.trading_date,
                COALESCE(va.volume_50d_avg, p.volume) as volume_50d_avg,
                COALESCE(pc.prev_close, p.close) as prev_close
            FROM instruments i
            INNER JOIN latest_prices lp ON i.symbol_key = lp.symbol_key
            INNER JOIN price_daily p ON i.symbol_key = p.symbol_key AND p.trading_date = lp.latest_date
            LEFT JOIN indicator_daily ind ON i.symbol_key = ind.symbol_key AND ind.trading_date = lp.latest_date
            LEFT JOIN latest_rs lr ON i.symbol_key = lr.symbol_key
            LEFT JOIN volume_avg va ON i.symbol_key = va.symbol_key
            LEFT JOIN prev_close pc ON i.symbol_key = pc.symbol_key
            WHERE i.market = 'US' 
                AND i.is_active = TRUE
                AND COALESCE(lr.rs_score, 0) >= 80
            ORDER BY COALESCE(lr.rs_score, 0) DESC, i.symbol_key
        """
        
        stocks = self.db.execute_query(query)
        
        results = []
        for stock in stocks:
            symbol, name, close, volume, sma20, sma50, sma200, ema21, ema50, \
            rsi14, macd, macd_signal, macd_hist, high_52w, low_52w, \
            dist_to_52w_high_pct, rs_score, atr14, trading_date, volume_50d_avg, prev_close = stock
            
            # 株価チEEタ準備E新Total Score v2用EE
            stock_data = {
                'close': float(close),
                'sma20': float(sma20) if sma20 else None,
                'sma50': float(sma50) if sma50 else None,
                'sma200': float(sma200) if sma200 else None,
                'volume': float(volume),
                'volume_50d_avg': float(volume_50d_avg) if volume_50d_avg else float(volume),
                'macd_hist': float(macd_hist) if macd_hist else None,
                'rsi14': float(rsi14) if rsi14 else None,
                'high_52w': float(high_52w) if high_52w else float(close),
                'atr14': float(atr14) if atr14 else None
            }
            
            # 新Total Score計箁E
            score_result = self.calculate_total_score_v2(stock_data)
            total_score = score_result['total_score']
            volume_ratio = score_result['vol_ratio']
            
            # 前日比計箁E
            change_pct = ((float(close) - float(prev_close)) / float(prev_close) * 100) if prev_close else 0.0
            
            # シグナル判宁E
            signals = []
            if macd_hist and float(macd_hist) > 0:
                signals.append("MACD+")
            if dist_to_52w_high_pct and float(dist_to_52w_high_pct) >= -5:
                signals.append("BREAKOUT")
            if rs_score and float(rs_score) >= 80:
                signals.append("HIGH_RS")
            
            results.append({
                'rank': 0,  # 後で付丁E
                'symbol': symbol,
                'name': name,
                'score': round(total_score, 1),
                'scores_detail': score_result['subscores'],
                'price': float(close),
                'change_pct': round(change_pct, 2),
                'rs_score': int(rs_score) if rs_score else None,
                'dist_to_52w_high_pct': round(float(dist_to_52w_high_pct), 2) if dist_to_52w_high_pct else None,
                'volume_ratio': round(volume_ratio, 2),
                'rsi14': round(float(rsi14), 1) if rsi14 else None,
                'signals': signals
            })
        
        # Total Score >= 70 でフィルタリング
        filtered_results = [r for r in results if r['score'] >= 70]
        
        # ペEジネEション適用
        total_count = len(filtered_results)
        paginated_results = filtered_results[offset:offset + limit]
        
        # ランク付丁E
        for i, result in enumerate(paginated_results, start=offset + 1):
            result['rank'] = i
        
        return {
            'results': paginated_results,
            'count': len(paginated_results),
            'total_stocks': total_count,
            'offset': offset,
            'limit': limit,
            'has_more': (offset + limit) < total_count
        }
    
    def __del__(self):
        """チEトラクタでDB刁E"""
        try:
            self.db.disconnect()
        except:
            pass
